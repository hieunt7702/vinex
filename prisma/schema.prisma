generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int        @id @default(autoincrement())
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  name        String
  slug        String     @unique
  type        String     @default("Sản phẩm") // "Sản phẩm", "Bài viết"
  description String?
  status      String     @default("ACTIVE")
  isPinned    Boolean    @default(false)
  attributes  Json?
  products    Product[]  @relation("ProductToCategory")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id                Int        @id @default(autoincrement())
  productId         String?
  sku               String?
  name              String
  slug              String     @unique
  segment           String?    @default("cao-cap")
  price             Int?
  promotionalPrice  Int?
  stockQuantity     Int?       @default(100)
  stockStatus       String?    @default("IN_STOCK")
  lowStockThreshold Int?       @default(10)
  shortDescription  String?
  description       String?
  status            String     @default("ACTIVE")
  images            Json?
  attributes        Json?
  categories        Category[] @relation("ProductToCategory")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Article {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  category        String
  author          String?  @default("VINEX Editorial")
  summary         String?
  content         String?
  thumbnail       String?
  views           Int      @default(0)
  status          String   @default("PUBLISHED")
  isFeatured      Boolean  @default(false)
  tags            String?
  metaTitle       String?
  metaDescription String?
  publishedAt     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Lead {
  id                 Int      @id @default(autoincrement())
  customerName       String
  companyName        String?
  phone              String
  email              String?
  location           String?
  source             String?  @default("Website")
  productGroup       String?  // Nhóm sản phẩm quan tâm (Hạt điều, Trà/Cà phê, Bánh kẹo, Quà Tết...)
  purpose            String?  // Mục đích sử dụng (Quà Tết doanh nghiệp, Tri ân đối tác, Bán lẻ...)
  quantity           String?  // Số lượng dự kiến
  budget             String?  // Ngân sách dự kiến
  timeline           String?  // Thời gian giao hàng mong muốn
  customization      String?  // Tùy chỉnh thương hiệu (In ép kim logo, Ruy băng, Thiệp...)
  notes              String?  // Yêu cầu chi tiết & Ghi chú
  status             String   @default("NEW") // NEW, CONTACTED, CONSULTING, WON, LOST
  leadClassification String?  @default("WARM") // HOT, WARM, COLD
  assignee           String?  // Nhân viên phụ trách tư vấn
  projectType        String?  // Dự phòng tương thích ngược
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Customer {
  id          Int      @id @default(autoincrement())
  fullName    String
  phoneNumber String
  email       String?
  address     String?
  requestType String?  // Loại yêu cầu (Quà tặng doanh nghiệp, Hạt điều & Nông sản, Cung ứng, OEM...)
  totalOrders Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String
  name      String
  type      String
  size      Int
  createdAt DateTime @default(now())
}

model SeoPage {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  keyword         String?
  content         String?
  status          String   @default("ACTIVE")
  metaTitle       String?
  metaDescription String?
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
