generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int        @id @default(autoincrement())
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  name        String
  slug        String     @unique
  type        String     @default("Sản phẩm") // "Sản phẩm", "Bài viết"
  description String?
  status      String     @default("ACTIVE")
  isPinned    Boolean    @default(false)
  attributes  Json?
  products    Product[]  @relation("ProductToCategory")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id                Int        @id @default(autoincrement())
  productId         String?
  sku               String?
  name              String
  slug              String     @unique
  segment           String?    @default("cao-cap")
  price             Int?
  promotionalPrice  Int?
  stockQuantity     Int?       @default(100)
  stockStatus       String?    @default("IN_STOCK")
  lowStockThreshold Int?       @default(10)
  shortDescription  String?
  description       String?
  status            String     @default("ACTIVE")
  images            Json?
  attributes        Json?
  categories        Category[] @relation("ProductToCategory")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([productId])
}

model Article {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  category        String
  author          String?  @default("VINEX Editorial")
  summary         String?
  content         String?
  thumbnail       String?
  views           Int      @default(0)
  status          String   @default("PUBLISHED")
  isFeatured      Boolean  @default(false)
  tags            String?
  metaTitle       String?
  metaDescription String?
  publishedAt     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([isFeatured])
}

model Lead {
  id                 Int      @id @default(autoincrement())
  requestCode        String?  @unique
  customerName       String
  companyName        String?
  phone              String
  email              String?
  location           String?
  source             String?  @default("Website")
  sourceUrl          String?
  sourceProduct      String?
  utmParams          Json?
  
  purpose            String?  // BUY_PRODUCT, PERSONAL_GIFT, CORPORATE_GIFT, WHOLESALE, SUPPORT, PARTNERSHIP, OTHER
  productGroup       String?  // Tên hiển thị mục đích/nhóm
  
  preferredChannel   String?  // Phone, Zalo, Email
  preferredTime      String?  // Buổi sáng, Buổi chiều, hoặc tự nhập
  
  quantity           String?  // Số lượng dự kiến
  budget             String?  // Ngân sách dự kiến
  timeline           String?  // Thời gian giao hàng mong muốn
  customization      String?  // Tùy chỉnh thương hiệu
  notes              String?  // Yêu cầu chi tiết & Ghi chú ban đầu
  
  details            Json?    // Các trường động chi tiết theo từng loại nhu cầu
  attachments        Json?    // Danh sách tệp đính kèm của khách [{name, url, size, type}]
  
  consentVersion     String?  @default("v1.0")
  marketingOptIn     Boolean  @default(false)
  isRead             Boolean  @default(false)
  
  status             String   @default("NEW") // NEW, ASSIGNED, PROCESSING, WAITING_CUSTOMER, WAITING_INTERNAL, CLOSED
  priority           String?  @default("NORMAL") // NORMAL, HIGH, URGENT
  leadClassification String?  @default("WARM") // HOT, WARM, COLD
  assignee           String?  // Nhân viên phụ trách
  internalReason     String?  // Lý do & bộ phận khi WAITING_INTERNAL
  
  nextFollowUpDate   String?  // Hẹn xử lý tiếp
  lastContactDate    String?  // Liên hệ gần nhất
  firstResponseAt    String?  // Phản hồi đầu tiên
  
  closingResult      String?  // ORDER_CREATED, RESOLVED, NO_NEED, DISAGREED, UNREACHABLE, CANCELLED, DUPLICATE, SPAM
  closingNote        String?  // Lý do chi tiết khi đóng
  linkedOrderCode    String?  // Mã đơn hàng liên kết
  orderValue         Int?     // Doanh thu đơn hàng thực tế VNĐ
  linkedRequestId    String?  // Mã yêu cầu chính nếu trùng
  closedAt           String?
  
  verifiedInfo       Json?    // Thông tin đã xác minh sau khi trao đổi
  activities         Json?    // Dòng thời gian hoạt động & note nội bộ [{id, createdAt, author, type, content, contactResult, nextAction, nextActionDeadline, attachments}]
  quotations         Json?    // Danh sách báo giá [{id, quoteCode, version, value, validUntil, sentAt, sentBy, fileUrl, fileName, notes}]
  auditLog           Json?    // Nhật ký hệ thống [{id, timestamp, user, action, details}]
  reopenHistory      Json?    // Lịch sử mở lại [{reopenedAt, reopenedBy, reason}]
  
  projectType        String?  // Dự phòng tương thích ngược
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Performance indexes for common query patterns
  @@index([status])
  @@index([priority])
  @@index([assignee])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([assignee, status])
}

model Customer {
  id          Int      @id @default(autoincrement())
  fullName    String
  phoneNumber String
  email       String?
  address     String?
  requestType String?  // Loại yêu cầu (Quà tặng doanh nghiệp, Hạt điều & Nông sản, Cung ứng, OEM...)
  totalOrders Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
  @@index([email])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String
  name      String
  type      String
  size      Int
  createdAt DateTime @default(now())
}

model SeoPage {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  keyword         String?
  content         String?
  status          String   @default("ACTIVE")
  metaTitle       String?
  metaDescription String?
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
